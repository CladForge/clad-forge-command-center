{
  "compilerOptions": {
    /* Target modern browsers — same baseline Vite uses */
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "useDefineForClassFields": true,

    /* React 19 with the new JSX transform — no need to import React */
    "jsx": "react-jsx",

    /* Vite handles compilation; tsc is for type-checking only */
    "noEmit": true,
    "skipLibCheck": true,

    /* Strict mode for any NEW .ts/.tsx files written.
       Existing .jsx files keep working untouched (allowJs + checkJs: false). */
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,

    /* Coexistence with existing JS codebase. Without these the migration
       would have to be all-or-nothing — instead JSX files are simply
       ignored by tsc and any new TSX file gets full type-checking. */
    "allowJs": true,
    "checkJs": false
  },
  "include": ["src"]
}
